# INTERVUE AI — Environment Variable Reference
#
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# All .env*.local files are already in .gitignore.
#
# ============================================================
# DATABASE (PostgreSQL via Prisma)
# ============================================================

# Connection string for your PostgreSQL database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# ============================================================
# AUTHENTICATION
# ============================================================

# A secret used to sign/verify session tokens or JWTs.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public Base URL for OAuth Callbacks & Canonical SEO Links
NEXT_PUBLIC_APP_URL=https://intervue.ai

# ============================================================
# GOOGLE OAUTH 2.0 (Stage 11)
# ============================================================

# Google OAuth Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=

# Google OAuth Client Secret (SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER)
GOOGLE_CLIENT_SECRET=

# Google OAuth Redirect Callback URI
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ============================================================
# AI PROVIDER (OpenAI)
# ============================================================

# OpenAI API key — used by the AI Tutor (server-side only, never exposed to browser)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI model to use for tutoring. Defaults to gpt-4o-mini if not set.
# Options: gpt-4o-mini (default, cost-efficient), gpt-4o (higher quality)
OPENAI_MODEL=gpt-4o-mini

# ---- REMOVED in Stage 6 ----
# ANTHROPIC_API_KEY and GEMINI_API_KEY are not used. Do not add them.
# AI_PROVIDER switching is not implemented in Stage 6.

# ============================================================
# CODE EXECUTION (Judge0 API)
# ============================================================

# Judge0 API key (from RapidAPI or self-hosted Judge0)
JUDGE0_API_KEY=

# Judge0 base URL
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com

# ============================================================
# OPTIONAL: RATE LIMITING (Upstash Redis)
# ============================================================

# Redis URL for rate limiting auth endpoints
UPSTASH_REDIS_REST_URL=

# Upstash Redis token
UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# OPTIONAL: EMAIL (for password reset, verification)
# ============================================================

# SMTP or transactional email provider
EMAIL_FROM=noreply@intervue.ai
RESEND_API_KEY=

# ============================================================
# OPTIONAL: STORAGE (for audio recordings if STT added)
# ============================================================

# Vercel Blob or S3 for audio storage
BLOB_READ_WRITE_TOKEN=

# ============================================================
# ENVIRONMENT
# ============================================================

# Set to 'production' on Vercel automatically
NODE_ENV=development
